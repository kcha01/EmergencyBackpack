@page "/emergencyBackpack"
@rendermode InteractiveServer

@using ViewModel
@using Models

@inject MainViewModel viewModel;
<h3>Emergency Backpack</h3>

<div class="card p-3 shadow-sm">
    <div class="mb-3">
        <label>Nazwa przedmiotu</label>
        <input class="form-control" @bind="viewModel.NewItem" />
    </div>

    <div class="mb-3">
        <label>Kategoria</label>

        <select class="form-control" @bind="viewModel.SelectedCategory">
            <option value="">Wybierz kategorie </option>

            @foreach (var category in viewModel.Categories)
            {
                <option value="@category">
                    @category
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Ważność</label>

        <select class="form-control" @bind="viewModel.SelectedPriority">
            <option value="">Wybierz stopień ważności przedmiotu </option>

            @foreach (var category in viewModel.Priority)
            {
                <option value="@category">
                    @category
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Ilość sztuk</label>
        <input class="form-control" min ="1" step="1" type="number" @bind="viewModel.Count" pattern="[0-9]+" />
    </div>

    <div class="mb-3">
        <label>Cena za 1 sztukę</label>
        <input class="form-control" type="number" step= "0.01" min="0" @bind="viewModel.PricePerItemas" pattern="[0-9]+([.][0-9]{1,2})?" />
    </div>


    <button class="btn btn-secondary w-50" @onclick="AddItem">
        Dodaj Przedmiot
    </button>

</div>


<h3>Liczba przedmiotów: @viewModel.Items.Count </h3>
<h3>Liczba przygotowanych przedmiotów: @viewModel.Items.Count(x =>x.IsPrepared) </h3>
<h3>Cena całego plecaka: @Math.Round(viewModel.Items.Sum(x =>x.HowMany * x.PricePerItem), 2) zł</h3>


<h4>Plecak</h4>

<div class="mb-3">
    <label>Filtruj po kategorii</label>

    <select class="form-control" @bind="selectedCategory">
        <option value="">Wszystkie kategorie</option>

        @foreach (var category in viewModel.Categories)
        {
            <option value="@category">@category</option>
        }
    </select>
</div>

@if (viewModel.Items.Count == 0)
{
    <h1>Brak przedmiotów</h1>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Tytuł</th>
                <th>Kategoria</th>
                <th>Cena łącznie</th>
                <th>Ilość sztuk</th>
                <th>Ważność</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in viewModel.Items
            .Where(x => string.IsNullOrEmpty(selectedCategory) ||
                x.Category == selectedCategory)
            .OrderBy(x => x.Priority == "Niezbędne" ? 0 :
                  x.Priority == "Ważne" ? 1 :
                  x.Priority == "Mało ważne" ? 2 : 3))
       
            {
                
                <tr class="@(item.Priority == "Niezbędne" ? "table-danger" : item.Priority == "Ważne" ? "table-warning" : "")">
                    <td>@item.Title</td>

                    <td>@item.Category</td>

                    <td>@(item.PricePerItem*item.HowMany) zł</td>

                    <td>@item.HowMany</td>

                    <td>
                        @if (item.Priority == "Niezbędne")
                        {
                            <span class="badge bg-danger">
                                Niezbędne
                            </span>
                        }
                        else if (item.Priority == "Ważne")
                        {
                        <span class="badge bg-warning">
                            Ważne
                        </span>
                        }
                        else
                        {
                        <span class="badge bg-success">
                            Mało ważne
                        </span>
                        }
                    </td>

                    <td>
                        @if (item.isPrepared)
                        {
                            <span class="badge bg-success">
                                Przygotowane
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Nie przygotowane
                            </span>
                        }

                    </td>

                    <td>
                        <button class="btn btn-success btn-sm me-2" @onclick="() => TogglePrepared(item)">
                            Zmień Status
                        </button>

                        <button class="btn btn-danger btn-sm me-2" @onclick="() => RemoveItem(item)">
                            Usuń
                        </button>

                    </td>

                </tr>

            }
        </tbody>

    </table>
}
@code {
    private void AddItem()
    {
        viewModel.AddItemCommand.Execute(null);
    }

    private void RemoveItem(BackpackItem item)
    {
        viewModel.RemoveItemCommand.Execute(item);
    }

    private void TogglePrepared(BackpackItem item)
    {
        viewModel.TogglePreparedCommand.Execute(item);
    }
    private string selectedCategory = "";
}
